# Copy to `.dev.vars` and fill in — `wrangler dev` reads it automatically.
# `.dev.vars` is gitignored; never commit real secrets.

# --- Meta / WhatsApp Cloud API ---
META_WA_ENDPOINT=https://graph.facebook.com/v22.0/REPLACE_PHONE_NUMBER_ID
META_WA_TOKEN=REPLACE_ME
META_WH_TOKEN=REPLACE_ME
META_APP_SECRET=REPLACE_ME

# --- Azure OpenAI (AI assistant) ---
AZURE_OPENAI_ENDPOINT=https://REPLACE_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_API_VERSION=2024-08-01-preview
AZURE_MODEL_DEPLOYMENT=gpt-4o-mini
ASSISTANT_ID=asst_REPLACE

# --- Billing lookup (tier gate) ---
# Stub endpoint returning { authorized: bool, tier: string }
BILLING_API_URL=https://billing.example.com/subscriptions
BILLING_API_TOKEN=REPLACE_ME

# --- Optional: local mock Meta ---
# META_GRAPH_BASE_URL=http://localhost:4000
