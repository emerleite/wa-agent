{
	"name": "wa-agent-example-full-bot",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Reference example — every wa-agent primitive wired at once. Not a starting point.",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"db:create": "wrangler d1 create full-bot",
		"db:migrate": "wrangler d1 migrations apply full-bot --local --migrations-dir ../../migrations",
		"db:migrate:remote": "wrangler d1 migrations apply full-bot --remote --migrations-dir ../../migrations",
		"kv:create": "wrangler kv namespace create full-bot-kv",
		"r2:create": "wrangler r2 bucket create full-bot-tts",
		"mock:meta": "tsx ../../tools/mock-meta-server.ts"
	},
	"dependencies": {
		"hono": "^4.4.4",
		"openai": "~4.57.0",
		"@emerleite/wa-agent": "file:../.."
	},
	"devDependencies": {
		"@hono/node-server": "^2.0.6",
		"tsx": "^4.22.4",
		"wrangler": "^4.0.0"
	}
}
