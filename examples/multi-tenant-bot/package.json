{
	"name": "wa-agent-example-multi-tenant-bot",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "BSP-style multi-tenant example — one Worker, many WhatsApp numbers.",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"db:create": "wrangler d1 create multi-tenant-bot",
		"db:migrate": "wrangler d1 migrations apply multi-tenant-bot --local --migrations-dir ../../migrations",
		"db:migrate:remote": "wrangler d1 migrations apply multi-tenant-bot --remote --migrations-dir ../../migrations",
		"kv:create": "wrangler kv namespace create multi-tenant-bot-kv",
		"mock:meta": "tsx ../../tools/mock-meta-server.ts"
	},
	"dependencies": {
		"hono": "^4.4.4",
		"openai": "~4.57.0",
		"wa-agent": "file:../.."
	},
	"devDependencies": {
		"@hono/node-server": "^2.0.6",
		"tsx": "^4.22.4",
		"wrangler": "^4.0.0"
	}
}
