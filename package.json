{
	"name": "@emerleite/wa-agent",
	"version": "0.16.2",
	"description": "Opinionated WhatsApp Cloud API agent framework for Cloudflare Workers — Drizzle-backed stores, D1-coalesced webhook queue, AI assistant integration with pluggable reply enrichment, opt-in CRM, account-link redemption, broadcast cron, sequential drip plans, rate-capped opportunistic side-channel sends, Zod-validated event stream + Analytics Engine sink, and a composable intent → policy → LLM → audit pipeline.",
	"author": "Emerson Leite",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/emerleite/wa-agent.git"
	},
	"bugs": {
		"url": "https://github.com/emerleite/wa-agent/issues"
	},
	"homepage": "https://github.com/emerleite/wa-agent#readme",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"wa-agent": "./bin/wa-agent.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./hono": {
			"types": "./dist/hono.d.ts",
			"default": "./dist/hono.js"
		},
		"./ai-sdk": {
			"types": "./dist/ai_sdk/index.d.ts",
			"default": "./dist/ai_sdk/index.js"
		},
		"./migrations/*": "./migrations/*"
	},
	"files": [
		"dist",
		"src",
		"bin",
		"examples",
		"migrations",
		"scripts",
		"tools",
		"README.md",
		"CHANGELOG.md",
		"bash.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:unit": "vitest run -c vitest.config.unit.ts",
		"test:mutate": "stryker run",
		"db:generate": "drizzle-kit generate",
		"check:hardcoded": "bash scripts/check-hardcoded.sh",
		"mock:meta": "tsx tools/mock-meta-server.ts"
	},
	"keywords": [
		"whatsapp",
		"cloudflare-workers",
		"d1",
		"agent",
		"llm",
		"chatbot",
		"meta",
		"hono"
	],
	"engines": {
		"node": ">=18"
	},
	"peerDependencies": {
		"@hono/node-server": "^1.0.0 || ^2.0.0",
		"ai": "^6.0.0 || ^7.0.0",
		"hono": "^4.0.0",
		"openai": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"hono": {
			"optional": true
		},
		"openai": {
			"optional": true
		},
		"@hono/node-server": {
			"optional": true
		},
		"ai": {
			"optional": true
		}
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.5.16",
		"@cloudflare/workers-types": "^4.20240909.0",
		"@hono/node-server": "^2.0.6",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@vitest/coverage-istanbul": "^2.0.5",
		"ai": "^6.0.230",
		"drizzle-kit": "^0.30.6",
		"hono": "^4.4.4",
		"openai": "~4.57.0",
		"tsx": "^4.22.4",
		"typescript": "^5.6.0",
		"vitest": "^2.0.5"
	},
	"license": "MIT",
	"dependencies": {
		"drizzle-orm": "^0.38.4",
		"zod": "^3.25.76"
	}
}
