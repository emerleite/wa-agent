{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"_comment": "Mutation testing for wa-agent. Mutates only files exercised by the unit suite (vitest.config.unit.ts) — pure CRUD-over-Drizzle files (UsageCounter, PreferenceStore, MessageLog, SessionStore, LeadStore, MessageWindow, SequentialPlan, Broadcast, ReEngagement, ChannelOptOuts, AccountLinkStore, ContentGenerator, EscalationStore, ConsentStore, MultiTenantAgentRegistry, AgentReviewQueue, AICallLedger, AIRouter, BotSendPacing) are intentionally excluded because there's no algorithmic logic to mutate; their behavior is verified by test/integration/. Any new pure-logic module MUST be added to `mutate` below — see CLAUDE.md.",
	"packageManager": "npm",
	"testRunner": "vitest",
	"vitest": {
		"configFile": "vitest.config.unit.ts"
	},
	"mutate": [
		"src/webhook/extract.ts",
		"src/webhook/verify.ts",
		"src/router/command_router.ts",
		"src/router/button_router.ts",
		"src/util/text.ts",
		"src/gate/access_gate.ts",
		"src/gate/tier_provider.ts",
		"src/search/hybrid_search.ts",
		"src/scheduler/slot_delivery.ts",
		"src/queue/d1_coalesce_queue.ts",
		"src/flow/onboarding.ts",
		"src/flow/upsell.ts",
		"src/media/azure_tts.ts",
		"src/media/r2_cache.ts",
		"src/ai/openai_assistant.ts",
		"src/ai/summarizer.ts",
		"src/ai/transcriber.ts",
		"src/dashboard/index.ts",
		"src/util/quiet_hours.ts",
		"src/util/utm.ts",
		"src/gate/payment_link_provider.ts",
		"src/ai/reply_enricher.ts",
		"src/media/button_image_dispatcher.ts",
		"src/scheduler/rate_capped_dispatcher.ts",
		"src/util/jwt.ts",
		"src/usage/llm_cost.ts",
		"src/security/rate_limit.ts",
		"src/util/normalize_identifier.ts",
		"src/util/holdout.ts",
		"src/ai/heuristic_fallback_classifier.ts",
		"src/ai/circuit_breaker.ts",
		"src/ai/llm_provider.ts",
		"src/util/phone_br.ts",
		"src/util/whatsapp_format.ts",
		"src/util/llm_json.ts",
		"src/util/log.ts",
		"src/util/state_block.ts",
		"src/util/streak.ts",
		"src/util/reply_context.ts",
		"src/util/db_error.ts",
		"src/util/og_landing.ts",
		"src/ai/pt_br_intents.ts",
		"src/ai/provider_limits.ts",
		"src/ai/llm_classifier.ts",
		"src/ai/safety_footer.ts",
		"src/media/r2_media_store.ts",
		"src/media/media_pipeline.ts",
		"src/security/admin_auth.ts",
		"src/security/crypto.ts",
		"src/security/cookie.ts",
		"src/observability/tracer.ts"
	],
	"thresholds": {
		"high": 80,
		"low": 60,
		"break": 40
	},
	"coverageAnalysis": "perTest",
	"reporters": ["html", "clear-text", "progress"],
	"timeoutMS": 60000,
	"concurrency": 4,
	"htmlReporter": {
		"fileName": "reports/mutation/index.html"
	},
	"_disableTypeChecking": true,
	"checkers": [],
	"tempDirName": ".stryker-tmp"
}
