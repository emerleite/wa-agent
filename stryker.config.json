{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"_comment": "Mutation testing for wa-agent. Mutates only files exercised by the unit suite (vitest.config.unit.ts) — files that are pure-SQL CRUD (UsageCounter, MessageLog, SessionStore, LeadStore, MessageWindow, SequentialPlan, Broadcast, ReEngagement) are intentionally excluded because there's no algorithmic logic to mutate; their behavior is verified by test/integration/.",
	"packageManager": "npm",
	"testRunner": "vitest",
	"vitest": {
		"configFile": "vitest.config.unit.ts"
	},
	"mutate": [
		"src/webhook/extract.ts",
		"src/webhook/verify.ts",
		"src/router/command_router.ts",
		"src/router/button_router.ts",
		"src/util/text.ts",
		"src/gate/access_gate.ts",
		"src/gate/tier_provider.ts",
		"src/search/hybrid_search.ts",
		"src/scheduler/slot_delivery.ts",
		"src/queue/d1_coalesce_queue.ts",
		"src/flow/onboarding.ts",
		"src/flow/upsell.ts",
		"src/media/azure_tts.ts",
		"src/media/r2_cache.ts",
		"src/ai/openai_assistant.ts",
		"src/ai/summarizer.ts",
		"src/ai/transcriber.ts",
		"src/dashboard/index.ts",
		"src/preference/preference_store.ts"
	],
	"thresholds": {
		"high": 80,
		"low": 60,
		"break": 40
	},
	"coverageAnalysis": "perTest",
	"reporters": ["html", "clear-text", "progress"],
	"timeoutMS": 60000,
	"concurrency": 4,
	"htmlReporter": {
		"fileName": "reports/mutation/index.html"
	},
	"_disableTypeChecking": true,
	"checkers": [],
	"tempDirName": ".stryker-tmp"
}
